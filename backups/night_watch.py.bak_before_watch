    ap.add_argument("--turbo-minutes", type=float, default=5.0)
    ap.add_argument("--fast-minutes", type=float, default=10.5)
    ap.add_argument("--slow-minutes", type=float, default=20.0)
    ap.add_argument("--no-front", action="store_true", help="刷到了不推到面前（实测用）")
    ap.add_argument("--rehearse", action="store_true",
                    help="演练：拿现在能买的 iPhone 17 走一遍「刷到→推到面前→响铃」")
    args = ap.parse_args()
    label = "512 白"
    if args.rehearse:
        setup_rehearsal()
        args.start, label = "now", "iPhone 17（演练）"

    if args.selftest:
        selftest()
        return
    global FRONT
    FRONT = not args.no_front

    threading.Thread(target=lw._ring_worker, daemon=True).start()
    go_now = threading.Event()
    paused = threading.Event()
    started = threading.Event()
    unlock_at = [None]

    def on_key(ch):
        # Return = 任何时候强制关闭
        if ch in ("\r", "\n"):
            hard_stop()
            restore_tty()
            os._exit(0)

    def on_ctrl_c(_sig, _frm):
        # Control+C = 开刷（19:55 解禁后才算数）。暂停中 / 刷到后 = 接着刷。
        if started.is_set() and paused.is_set():
            paused.clear()
        elif started.is_set():
            sys.stdout.write("\r\033[K（已经在刷了。要关闭请按 Return）\n")
        elif unlock_at[0] is not None and now_bj() >= unlock_at[0]:
            go_now.set()
        elif unlock_at[0] is not None:
            sys.stdout.write("\r\033[K（还没到 %s 解禁，Control+C 不算数）\n"
                             % unlock_at[0].astimezone().strftime("%H:%M"))
        sys.stdout.flush()
    signal.signal(signal.SIGINT, on_ctrl_c)

    def stdin_worker():
        try:
            if sys.stdin.isatty():
                while True:
                    ch = sys.stdin.read(1)
                    if not ch:
                        return
                    on_key(ch)
            else:                      # 不是终端（测试用管道）：按行读
                for line in sys.stdin:
                    on_key(line[:1] if line.strip() else "\n")
        except Exception:
            pass
    setup_tty()
    threading.Thread(target=stdin_worker, daemon=True).start()

    if args.start == "now":
        start = now_bj()
        unlock_at[0] = start
    else:
        day = dt.datetime(LAUNCH_DAY.year, LAUNCH_DAY.month, LAUNCH_DAY.day, tzinfo=bj_tz())
        start = day.replace(hour=START_BJ[0], minute=START_BJ[1], second=START_BJ[2])
        unlock_at[0] = day.replace(hour=UNLOCK_BJ[0], minute=UNLOCK_BJ[1], second=UNLOCK_BJ[2])
    # 快/慢/停 的时间点按自动开刷时间算死，提前手动开刷不会让整晚多刷
    turbo_end = start + dt.timedelta(minutes=min(args.turbo_minutes, args.fast_minutes))
    fast_end = start + dt.timedelta(minutes=args.fast_minutes)
    slow_end = fast_end + dt.timedelta(minutes=args.slow_minutes)
    if now_bj() >= slow_end:
        print("已经过了 %s，开售时段结束了，不刷。" % two_clocks(slow_end))
        return

    print("解禁：  %s   （从这时起按 Control+C 就立刻开刷）" % two_clocks(unlock_at[0]))
    print("自动开刷：%s   （你不按的话）" % two_clocks(start))
    print("放慢于：%s" % two_clocks(fast_end))
    print("自动停：%s" % two_clocks(slow_end))
    print("开刷：19:55 解禁后按【Control + C】（左下角 control 键，不是 ⌘）")
    print("强制关闭：任何时候按【Return】\n")

    pos = wait_for_single_tab(DEEP_MATCH, label)
    print("盯住了：窗口 %d 第 %d 个标签。\n" % pos)

    # ---- 倒计时：一次都不刷；每 30 秒看一眼标签页还在不在、是不是还只有一个 ----
    # 显示每 0.05 秒更新、带毫秒，每次都现读系统时间（不会越积越慢）；自动开刷误差 < 0.05 秒。
    # 查标签页放到后台线程，免得 AppleScript 那零点几秒让倒计时卡一下。
    tab_state = {"pos": pos, "ok": True}
    countdown_over = threading.Event()

    def tab_watch():
        while not countdown_over.wait(TAB_CHECK_SECONDS):
            try:
                tabs = find_all(DEEP_MATCH)
            except Exception:
                continue
            if countdown_over.is_set():
                return
            if len(tabs) == 1:
                if not tab_state["ok"]:
                    print("\n标签页回来了：窗口 %d 第 %d 个。" % tabs[0][:2])
                tab_state["pos"], tab_state["ok"] = tabs[0][:2], True
            elif tab_state["ok"]:
                tab_state["ok"] = False
                beep(SOUND_WARN)
                print("\n！%s 的标签页%s。开刷前请弄好，否则到点要先等你。地址：\n    %s"
                      % (label, "不见了" if not tabs else "有 %d 个（应该只有 1 个）" % len(tabs), DEEP_URL))
    threading.Thread(target=tab_watch, daemon=True).start()

    def hms_ms(sec):
        sec = max(0.0, sec)
        ms = int((sec - int(sec)) * 1000)
        return "%s.%03d" % (hms(int(sec)), ms)

    while not go_now.is_set():
        t = now_bj()
        if t >= start:
            break
        # 每一行都要短于 80 列（窗口宽度），超了会折行、变回一秒冒一行。最长的「还有几天」那行 70 列。
        if not tab_state["ok"]:
            msg = "！标签页不对，见上面提示 · 距开刷 %s" % hms_ms((start - t).total_seconds())
        elif t < unlock_at[0]:
            msg = "距解禁 %s · 距自动开刷 %s" % (
                hms_ms((unlock_at[0] - t).total_seconds()), hms_ms((start - t).total_seconds()))
        else:
            msg = "已解禁！Control+C 开刷 · %s 后自动开刷" % hms_ms((start - t).total_seconds())
        lt = t.astimezone()
        status("[%s.%03d] %s" % (lt.strftime("%H:%M:%S"), lt.microsecond // 1000, msg))
        time.sleep(0.05)
    countdown_over.set()
    pos = tab_state["pos"]
    started.set()
    print("\n\n>>> %s，开始刷。[%s]\n" % ("你按了 Control+C" if go_now.is_set() else "到点了", two_clocks()))

    # ---- 开刷前最后确认标签页。网址只是漂走了（维护重定向之类）就直接拉回来，不等你 ----
    tabs = find_all(DEEP_MATCH)
    if len(tabs) == 1:
        pos = tabs[0][:2]
    elif not tabs and pos:
        u = tab_url(pos, tries=3).lower()
        if "apple.com.cn" in u and not any(h in u for h in HANDOVER_HINTS):
            print("标签页网址漂到了 %s，拉回深链接。" % u[:60])
            lw.set_tab_url(pos[0], pos[1], DEEP_URL)
            time.sleep(1.5)
        else:
            pos = wait_for_single_tab(DEEP_MATCH, label)
    else:
        pos = wait_for_single_tab(DEEP_MATCH, label)

    target_url, target_match = DEEP_URL, DEEP_MATCH
    dismissed, last_sig = {}, [None]     # 签名 -> 放过的时间

    def is_dismissed(sig):
        t_d = dismissed.get(sig)
        if t_d is None:
            return False
        if sig[0] == "hit" and time.time() - t_d > HIT_DISMISS_SECONDS:
            del dismissed[sig]                # 放过的「能买了」到期了，重新当新页面看
            return False
        return True
    n = 0
    soft404 = 0          # 连续几次「404 但直连正常」
    after_queue = 0      # 刚从排队页被放进来：还要「只看不刷」几轮（放行后页面可能还在跳转/加载）
    unclear = False      # 上一轮读页面失败
    unclear_streak = 0   # 连续几轮读页面失败（Safari 网页进程卡死时会一直失败，不能无限只看不刷）
    rounds_on_shop = 0   # 换到购买页之后刷了几轮
    try:
        while True:
            try:
                t0 = time.time()
                gap, phase = pace_for(now_bj(), start, turbo_end, fast_end, slow_end)
                if gap is None:
                    print("\n\n到 %s 了，自动停。窗口留着，你可以手动接着刷。" % two_clocks())
                    lw.notify("Duo 自动刷新", "到点自动停了，电脑这边不再刷。要继续就在 Safari 里手动刷。")
                    for _ in range(2):
                        subprocess.run(["afplay", lw.SOUND_DIR % SOUND_WARN], capture_output=True)
                    return

                navigated = False
                # 刚被排队页放进来：这一轮不刷新、不改网址（一动可能又回去排队），直接看当前页
                hold = after_queue > 0
                if hold:
                    after_queue -= 1
                peek, unclear = unclear, False   # 上一轮看不清页面：这一轮也不刷，只再看一次
                u = tab_url(pos, tries=3).lower()
                if not u:
                    # 连读三次都没有：标签页真没了（被关了 / Safari 重开了）。重新找，找不到就提示你打开
                    print("\n找不到正在刷的那个标签页了，重新找……")
                    pos = wait_for_single_tab(target_match, label)
                    print("找到了：窗口 %d 第 %d 个标签。" % pos)
                    continue
                if any(h in u for h in HANDOVER_HINTS):
                    print("\n\n你已经点进购物袋/结账了，脚本撒手不管。")
                    return
                if hold or peek:
                    navigated = True
                elif "404" in u:
                    # 只看 Safari 自己：第一次 404 等 30 秒再试，连续两次才算被挡。
                    # （不再用 Python 直连去复核：它的指纹不是 Safari，而且维护期间它看到的和 Safari 不一样）
                    soft404 += 1
                    if soft404 >= 2:
                        warn("连续两次跳到 404：被苹果挡了（Safari 这个会话），已停止刷新——再刷只会挡得更久。\n"
                             "  手机那条线不受影响，以手机为主继续刷。\n"
                             "  Mac 想再开一路：⌘⇧N 开无痕窗口、登录 Apple ID（要输密码），打开 %s 手动刷；"
                             "或等十几分钟自动解封。" % DEEP_URL, seconds=20)
                        time.sleep(21)
                        return
                    warn("跳到了 404。可能是被挡，也可能只是一时抽风——等 30 秒再试一次。",
                         sound=SOUND_TIP, seconds=2)
                    time.sleep(30)
                    lw.set_tab_url(pos[0], pos[1], target_url)
                    navigated = True
                else:
                    soft404 = 0
                    if target_match == SHOP_MATCH and DEEP_MATCH in u:
                        # 在购买页凑合时，上一轮试着设回深链接，这次没被跳走 = 深链接恢复了
                        print("\n深链接恢复了，换回去刷。")
                        target_url, target_match = DEEP_URL, DEEP_MATCH
                    elif target_match == DEEP_MATCH and DEEP_MATCH not in u and SHOP_MATCH in u:
                        # 深链接被苹果跳回了购买页：不去验证，直接在购买页上刷（购买页上也有判断要用的字）
                        warn("深链接被跳回了购买页，改刷购买页。每隔几轮会试一次深链接。",
                             sound=SOUND_TIP, seconds=4)
                        target_url, target_match = SHOP_URL, SHOP_MATCH
                        rounds_on_shop = 0
                    elif target_match not in u:
                        # 维护重定向之类：拉回来（拉回本身就是一次加载，这轮不再额外刷新）
                        lw.set_tab_url(pos[0], pos[1], target_url)
                        navigated = True

                # 在购买页上凑合着刷的时候，每隔几轮用 Safari 自己试一次深链接：设回去，下一轮看有没有被跳走
                if target_match == SHOP_MATCH and not hold and not navigated:
                    rounds_on_shop += 1
                    if rounds_on_shop % DEEP_RECHECK_ROUNDS == 0:
                        lw.set_tab_url(pos[0], pos[1], DEEP_URL)
                        navigated = True

                if not navigated:
                    lw.reload_tab(*pos)
                n += 1
                state, r = lw.probe(*pos)
                if hold and state in ("PENDING", "HIT", "MAYBE"):
                    after_queue = 0          # 页面已经稳住、看清了，之后照常
                hit_how = None
                if state == "HIT":
                    hit_how = "能买了——出现「加入购物袋」"
                elif state == "MAYBE" and hold:
                    hit_how = "能买了——排队放行后待售提示没了"   # 刚排完队，不刷新复核
                elif state == "MAYBE" and r and not r["buy"] and \
                        is_dismissed(("hit", r["prod"], round(r["chars"] / 500.0))):
                    state = "已放过的页面"        # 放过的页面不做复核刷新，省一次请求
                elif state == "MAYBE":
                    lw.reload_tab(*pos)
                    st2, r2 = lw.probe(*pos)
                    if st2 in ("HIT", "MAYBE"):
                        hit_how = "能买了——待售提示没了（复核两次）"
                        r = r2 or r
                    else:
                        state = "复核没过"

                # —— 认不出的页面：宁可误报，也绝不在你可能正在下单的页面上继续刷 ——
                why_pause, kind = None, None
                last_sig[0] = None
                q = None if (hit_how or state == "已放过的页面") else page_has_any(pos, QUEUE_WORDS)
                if q is not None or hit_how or state == "已放过的页面":
                    unclear_streak = 0
                if hit_how and r:
                    # 你按 Control+C 放过的「能买了」页面，同样的页面不再响——除非真出现了「加入购物袋」
                    hsig = ("hit", r["prod"], round(r["chars"] / 500.0))
                    if r["buy"] or not is_dismissed(hsig):
                        kind = "hit"
                        last_sig[0] = hsig
                    else:
                        hit_how, state = None, "已放过的页面"
                elif hit_how:
                    kind = "hit"
                elif state == "已放过的页面":
                    pass                                 # 上面已认定是放过的页面，不再往下判断
                elif q is None:
                    # 读页面失败：可能正好是排队页，刷新就丢位置。这一轮不判断，下一轮不刷新、只再看一次。
                    # 但连续 2 轮都看不清，多半是页面卡死了——第 3 轮照常刷新，就像人会按 ⌘R 一样。
                    unclear_streak += 1
                    unclear = unclear_streak < 2
                    state = "看不清（读页面失败%s）" % ("，下一轮不刷新" if unclear else "，下一轮照常刷新")
                elif page_has_any(pos, MAINT_WORDS):
                    state = "维护页"                     # 还没开卖，照常接着刷
                elif q:
                    kind = "queue"
                    why_pause = "这是排队页。千万别刷新、别关，等它自己放你进去。"
                elif r and not r["pending"] and r["chars"] >= lw.RENDER_FLOOR:
                    time.sleep(1.5)                       # 先排除「还没渲染完」
                    r3 = lw.read_tab(*pos)
                    hsig3 = r3 and ("hit", r3["prod"], round(r3["chars"] / 500.0))
                    if r3 and r3["prod"] and r3["buy"]:
                        kind, hit_how = "hit", "能买了——出现「加入购物袋」"
                    elif r3 and r3["prod"] and not r3["pending"] and r3["chars"] >= lw.RENDER_FLOOR:
                        # 还是商品页、待售提示没了 = 就是「能买了」的条件（只是刚才 probe 没等到它稳）
                        if not is_dismissed(hsig3):
                            kind, hit_how = "hit", "能买了——待售提示没了（等页面稳住后确认）"
                            last_sig[0] = hsig3
                        else:
                            state = "已放过的页面"
                    elif r3 and not r3["pending"] and r3["chars"] >= lw.RENDER_FLOOR:
                        sig = (r3["prod"], round(r3["chars"] / 500.0))
                        if not is_dismissed(sig):
                            kind = "unknown"
                            why_pause = "页面变样了（%d 字，待售提示没了），脚本认不出能不能买。" % r3["chars"]
                            last_sig[0] = sig

                if kind:
                    paused.set()
                    if kind == "hit":
                        notify_hit(pos, hit_how)
                    else:
                        print("\n" + "!" * 64)
                        print("‖ 已暂停刷新   [%s]" % two_clocks())
                        print("‖ " + why_pause)
                        print("‖ 能买 → 直接在 Safari 里买（不折抵 → AppleCare 第一个 → 加入购物袋）")
                        if kind == "queue":
                            print("‖ 排队页不会自动刷。进去了直接买；要关闭 → 按 Return")
                        else:
                            print("‖ 不能买 → 按 Control+C 立刻继续刷；你不碰它的话 %d 秒后自动接着刷" % AUTO_RESUME_SECONDS)
                            print("‖ 你动了鼠标/键盘、或页面有变化 → 一直等着，不会刷掉你选的   要关闭 → 按 Return")
                        print("‖ 按键前先点一下这个终端窗口（或 ⌘Tab 切回来），否则按在 Safari 上没用。")
                        if FRONT:
                            to_front(pos)
                        lw.notify("Duo 已暂停刷新", why_pause)
                        lw.start_ring(SOUND_WARN, 120)
                    # 等的时候出意外（Safari 忙、AppleScript 抽风）绝不能掉回主循环去刷新——
                    # 你可能正在这个页面上选 AppleCare。接着等就是了。
                    while True:
                        try:
                            how = wait_here(pos, paused, kind)
                            break
                        except KeyboardInterrupt:
                            raise
                        except Exception as e:
                            print("\n（暂停中出了个意外：%s——继续等你，不刷新）" % type(e).__name__)
                            time.sleep(1)
                    if how == "handover":
                        print("\n你已经点进购物袋/结账了，脚本撒手不管。")
                        return
                    if how == "queue_over":
                        print("\n>>> 排队页没了，苹果放你进来了。马上看这一页能不能买（不刷新）。[%s]" % two_clocks())
                        after_queue = 3      # 最多 3 轮只看不刷，直到页面稳住
                        continue
                    if last_sig[0]:
                        dismissed[last_sig[0]] = time.time()   # 同样的页面不再为它停（「能买了」60 秒后失效）
                    print("\n>>> %s继续刷。[%s]" % ("你按了 Control+C，" if how == "resume"
                                                   else "%d 秒没动静，自动" % AUTO_RESUME_SECONDS, two_clocks()))
                    continue

                tag = {"PENDING": "待售", "OTHER": "非商品页(维护/转圈)"}.get(state, state)
                status("[%s] 第 %d 次 · %s · %s节奏%s" % (time.strftime("%H:%M:%S"), n, tag, phase,
                                                    "" if target_match == DEEP_MATCH else " · 购买页"))

                rest = gap - (time.time() - t0)
                if rest > 0:
                    time.sleep(rest)

            except KeyboardInterrupt:
                raise
            except Exception as e:
                # 任何意外都不能让整晚停摆：记一笔，2 秒后接着来
                print("\n（出了个意外：%s: %s——2 秒后接着刷，不会停）" % (type(e).__name__, e))
                time.sleep(2)
                try:
                    if not tab_url(pos, tries=3):
                        pos = wait_for_single_tab(target_match, label)
                except Exception:
                    pass
    except KeyboardInterrupt:
        raise


def hard_stop():
    """Return：任何阶段（倒计时、刷新中、响铃中）立刻全停，连铃声一起掐掉。"""
    lw.stop_ring()
    subprocess.run(["pkill", "-x", "afplay"], capture_output=True)
    print("\n\n■ 已强制关闭。一次都不会再刷。Safari 窗口留着，你可以手动接着刷。")


if __name__ == "__main__":
    # 启动早期（还没装上「Control+C=开刷」之前）按 Control+C 就照常退出
    signal.signal(signal.SIGINT, signal.default_int_handler)
    try:
        main()
    except KeyboardInterrupt:
        hard_stop()
    finally:
        restore_tty()
