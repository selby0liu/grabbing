def hid_idle_seconds():
    """距离你上次动鼠标/触控板/键盘过了几秒（macOS 自己记的，不需要任何权限）。读不到返回 None。"""
    try:
        out = subprocess.run(["ioreg", "-c", "IOHIDSystem"], capture_output=True, text=True, timeout=3).stdout
        for line in out.splitlines():
            if "HIDIdleTime" in line:
                return int(line.split("=")[-1].strip()) / 1e9
    except Exception:
        pass
    return None


def page_fingerprint(pos):
    """整页文字的指纹。你在页面上点了选项，文字就会变——用来判断你是不是在操作。"""
    import hashlib
    t = lw.osa('tell application "Safari" to return (text of tab %d of window id %d) as string'
               % (pos[1], pos[0]))
    if not t:
        return None
    # 苹果页面会自己冒出又消失的读屏提示（10/13 实测：「图库已更新，」），不算你操作
    t = "\n".join(l for l in t.splitlines() if "已更新" not in l)
    return hashlib.md5(t.encode("utf-8")).hexdigest()


def page_has_any(pos, words):
    cond = " or ".join('(s contains "%s")' % w for w in words)
    out = lw.osa('''
tell application "Safari"
  set s to (text of tab %d of window id %d) as string
  return (%s) as string
end tell''' % (pos[1], pos[0], cond))
    if out not in ("true", "false"):
        return None          # 读页面失败（Safari 忙），不是「没有这些词」
    return out == "true"


def bj_tz():
    if ZoneInfo:
        return ZoneInfo("Asia/Shanghai")
    return dt.timezone(dt.timedelta(hours=8))


def now_bj():
    return dt.datetime.now(bj_tz())


def two_clocks(t=None):
    """同时给出北京和阿德莱德（本机）时间，免得换算出错。"""
    t = t or now_bj()
    return "北京 %s / 本机 %s" % (t.strftime("%H:%M:%S"),
                                 t.astimezone().strftime("%H:%M:%S"))


def hms(sec):
    sec = max(0, int(sec))
    d, sec = divmod(sec, 86400)
    h, sec = divmod(sec, 3600)
    m, sec = divmod(sec, 60)
    return ("%d 天 " % d if d else "") + "%02d:%02d:%02d" % (h, m, sec)


_tty_saved = None


def setup_tty():
    """让按键不用再按回车就能读到（Return 一按就生效）。"""
    global _tty_saved
    try:
        import termios, tty
        if sys.stdin.isatty():
            _tty_saved = termios.tcgetattr(sys.stdin)
            tty.setcbreak(sys.stdin.fileno())
    except Exception:
        _tty_saved = None


def restore_tty():
    try:
        import termios
        if _tty_saved is not None:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, _tty_saved)
    except Exception:
        pass


def status(text):
    """在同一行原地更新。\033[K 清掉行尾残字；文字保持短于 80 列，免得折行后变成一秒一行。"""
    sys.stdout.write("\r\033[K" + text)
    sys.stdout.flush()


def beep(name):
