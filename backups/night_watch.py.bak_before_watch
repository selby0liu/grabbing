        if len(tabs) == 1:
            return tabs[0][:2]
        msg = ("没找到 %s 的标签页。请在 Safari 里把这个地址粘进去打开：\n    %s"
               % (label, DEEP_URL)) if not tabs else \
              ("找到 %d 个 %s 的标签页，我不知道该刷哪个。请只留一个，其它关掉。"
               % (len(tabs), label))
        if msg != said:
            print("\n" + msg)
            beep(SOUND_WARN)
            said = msg
        time.sleep(3)


TURBO_GAP, FAST_GAP, SLOW_GAP = 2.0, 4.0, 12.0   # 秒，固定间隔（用户 10/16 要求固定、不要随机）


def pace_for(t, start, turbo_end, fast_end, slow_end):
    """间隔从「这一次开始刷」算到「下一次开始刷」。"""
    if t < start:
        return FAST_GAP, "快"          # 提前手动开刷的那几分钟：不算冲刺，免得 2 秒刷太久
    if t < turbo_end:
        return TURBO_GAP, "冲刺"
    if t < fast_end:
        return FAST_GAP, "快"
    if t < slow_end:
        return SLOW_GAP, "慢"
    return None, "停"


