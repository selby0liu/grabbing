# ---------- 停下来等你（刷到了 / 认不出 / 排队页 共用） ----------

def wait_here(pos, paused, kind):
    """kind: 'hit' 刷到了 / 'queue' 排队页 / 'unknown' 认不出。
    返回 'resume'（你按了 Control+C）/ 'auto'（10 秒没动静）/ 'handover'（你点进购物袋/结账了）
    / 'queue_over'（排队页没了，苹果放你进去了）。
    只有 'unknown' 会自动接着刷；'hit' 和 'queue' 一直等。你一碰鼠标键盘，铃声就停。"""
    fp0, fp_prev, same = None, page_fingerprint(pos), 0
    t_pause = time.time()
    touched = False
    last_queue_check = time.time()
    no_queue = 0
    while paused.is_set():
        if any(h in tab_url(pos).lower() for h in HANDOVER_HINTS):
            lw.stop_ring()
            return "handover"
        if kind == "queue" and time.time() - last_queue_check >= 2:
            last_queue_check = time.time()
            q = page_has_any(pos, QUEUE_WORDS)
            if q is False:
                no_queue += 1
            elif q is True:
                no_queue = 0          # 读不到（None）就不算数，等下一次
            if no_queue >= 2:
                paused.clear()
                lw.stop_ring()
                return "queue_over"
        left = AUTO_RESUME_SECONDS - (time.time() - t_pause)
        if not touched:
            # 暂停之后你动过鼠标/键盘 = 你在操作（哪怕页面卡着没变化），绝不自动刷
            idle = hid_idle_seconds()
            if idle is not None and idle + 0.5 < time.time() - t_pause:
                touched = True
            fp = page_fingerprint(pos)
            if fp0 is None:
                # 基准要等页面自己稳住（连续 3 次一样）才定——刚停下时页面可能还在懒加载
                same = same + 1 if (fp and fp == fp_prev) else 0
                if same >= 2:
                    fp0 = fp
                fp_prev = fp
            elif fp and fp != fp0:
                touched = True            # 稳住之后又变了 = 你在操作页面
            if touched:
                lw.stop_ring()            # 你一动，铃就停
            elif kind == "unknown" and left <= 0:
                paused.clear()
                lw.stop_ring()
                return "auto"
        if kind == "hit":
            tip = "能买就买 · 误判了按 Control+C 接着刷 · Return 关闭"
        elif kind == "queue":
            tip = "排队页 · 不自动刷 · Return 关闭"
        elif touched:
            tip = "你在操作 · 一直等你 · Control+C 继续刷 · Return 关闭"
        else:
            tip = "%d 秒后自动接着刷 · Control+C 立刻刷 · Return 关闭" % max(0, int(left + 0.99))
        status("[%s] 暂停中 · %s" % (time.strftime("%H:%M:%S"), tip))
        time.sleep(0.5)
    lw.stop_ring()
    return "resume"


