def find_all(match, exclude=None):
    """所有地址含 match 的标签页 [(窗口id, 序号, 网址)]。用来发现「开了不止一个」。"""
    cond = 'u contains "%s"' % match
    if exclude:
        cond += ' and u does not contain "%s"' % exclude
    out = lw.osa('''
tell application "Safari"
  set acc to ""
  repeat with w in windows
    set ti to 0
    repeat with t in tabs of w
      set ti to ti + 1
      try
        set u to ((URL of t) as string)
        if %s then set acc to acc & ((id of w) as string) & "," & (ti as string) & "," & u & linefeed
      end try
    end repeat
  end repeat
  return acc
end tell''' % cond)
    res = []
    for line in (out or "").splitlines():
        p = line.split(",", 2)
        if len(p) == 3:
            try:
                res.append((int(p[0]), int(p[1]), p[2]))
            except ValueError:
                pass
    return res


def tab_url(pos, tries=1):
    """读标签页网址。Safari 忙着加载时 AppleScript 会瞬时失败，重要场合多试几次再下结论。"""
    for i in range(tries):
        u = lw.osa('tell application "Safari" to return (URL of tab %d of window id %d) as string'
                   % (pos[1], pos[0]))
        if u:
            return u
        if i + 1 < tries:
            time.sleep(0.5)
    return ""


