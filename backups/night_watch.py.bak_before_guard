def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--selftest", action="store_true")
    ap.add_argument("--start", default="", help="'now' 立刻开始（实测用）；不填则等 10/16 北京 19:59:30")
    ap.add_argument("--fast-minutes", type=float, default=10.5)
    ap.add_argument("--slow-minutes", type=float, default=20.0)
    ap.add_argument("--no-front", action="store_true", help="刷到了不推到面前（实测用）")
    ap.add_argument("--rehearse", action="store_true",
                    help="演练：拿现在能买的 iPhone 17 走一遍「刷到→推到面前→响铃」")
    args = ap.parse_args()
    label = "512 白"
    if args.rehearse:
        setup_rehearsal()
        args.start, label = "now", "iPhone 17（演练）"

    if args.selftest:
        selftest()
        return
    global FRONT
    FRONT = not args.no_front

    threading.Thread(target=lw._ring_worker, daemon=True).start()
    go_now = threading.Event()
    paused = threading.Event()
    started = threading.Event()
    unlock_at = [None]

    def on_key(ch):
        # Return = 任何时候强制关闭
        if ch in ("\r", "\n"):
            hard_stop()
            restore_tty()
            os._exit(0)

    def on_ctrl_c(_sig, _frm):
        # Control+C = 开刷（19:55 解禁后才算数）。开刷之后再按不起作用——关闭用 Return。
        if started.is_set() and paused.is_set():
            paused.clear()               # 暂停中按 Control+C = 「不能买，继续刷」
        elif started.is_set():
            sys.stdout.write("\r\033[K（已经在刷了。要关闭请按 Return）\n")
        elif unlock_at[0] is not None and now_bj() >= unlock_at[0]:
            go_now.set()
        elif unlock_at[0] is not None:
            sys.stdout.write("\r\033[K（还没到 %s 解禁，Control+C 不算数）\n"
                             % unlock_at[0].astimezone().strftime("%H:%M"))
        sys.stdout.flush()
    import signal
    signal.signal(signal.SIGINT, on_ctrl_c)

    def stdin_worker():
        try:
            if sys.stdin.isatty():
                while True:
                    ch = sys.stdin.read(1)
                    if not ch:
                        return
                    on_key(ch)
            else:                      # 不是终端（测试用管道）：按行读
                for line in sys.stdin:
                    on_key(line[:1] if line.strip() else "\n")
        except Exception:
            pass
    setup_tty()
    threading.Thread(target=stdin_worker, daemon=True).start()

    if args.start == "now":
        start = now_bj()
        unlock_at[0] = start
    else:
        day = dt.datetime(LAUNCH_DAY.year, LAUNCH_DAY.month, LAUNCH_DAY.day, tzinfo=bj_tz())
        start = day.replace(hour=START_BJ[0], minute=START_BJ[1], second=START_BJ[2])
        unlock_at[0] = day.replace(hour=UNLOCK_BJ[0], minute=UNLOCK_BJ[1], second=UNLOCK_BJ[2])
    # 快/慢/停 的时间点按自动开刷时间算死，提前手动开刷不会让整晚多刷
    fast_end = start + dt.timedelta(minutes=args.fast_minutes)
    slow_end = fast_end + dt.timedelta(minutes=args.slow_minutes)
    if now_bj() >= slow_end:
        print("已经过了 %s，开售时段结束了，不刷。" % two_clocks(slow_end))
        return

    print("解禁：  %s   （从这时起按 Control+C 就立刻开刷）" % two_clocks(unlock_at[0]))
    print("自动开刷：%s   （你不按的话）" % two_clocks(start))
    print("放慢于：%s" % two_clocks(fast_end))
    print("自动停：%s" % two_clocks(slow_end))
    print("开刷：19:55 解禁后按【Control + C】（左下角 control 键，不是 ⌘）")
    print("强制关闭：任何时候按【Return】\n")

    pos = wait_for_single_tab(DEEP_MATCH, label)
    print("盯住了：窗口 %d 第 %d 个标签。\n" % pos)

    def hms(sec):
        sec = max(0, int(sec))
        d, sec = divmod(sec, 86400)
        h, sec = divmod(sec, 3600)
        m, sec = divmod(sec, 60)
        return ("%d 天 " % d if d else "") + "%02d:%02d:%02d" % (h, m, sec)

    while now_bj() < start and not go_now.is_set():
        t = now_bj()
        if t < unlock_at[0]:
            msg = "距解禁 %s · 距自动开刷 %s" % (
                hms((unlock_at[0] - t).total_seconds()), hms((start - t).total_seconds()))
        else:
            msg = "已解禁！Control+C 开刷 · %s 后自动开刷" % hms((start - t).total_seconds())
        status("[%s] %s" % (t.astimezone().strftime("%H:%M:%S"), msg))
        time.sleep(1)
    started.set()
    print("\n\n>>> %s，开始刷。[%s]\n" % ("你按了 Control+C" if go_now.is_set() else "到点了", two_clocks()))

    pos = wait_for_single_tab(DEEP_MATCH, label)
    target_url, target_match = DEEP_URL, DEEP_MATCH
    base_chars = None
    dismissed, last_sig = set(), [None]
    n = 0
    try:
        while True:
            t0 = time.time()
            gap, phase = pace_for(now_bj(), fast_end, slow_end)
            if gap is None:
                print("\n\n到 %s 了，自动停。窗口留着，你可以手动接着刷。" % two_clocks())
                return

            navigated = False
            u = tab_url(pos).lower()
            if any(h in u for h in HANDOVER_HINTS):
                print("\n\n你已经点进购物袋/结账了，脚本撒手不管。")
                return
            if "404" in u:
                k, why = clean_fetch(target_url)
                if k == "PRODUCT":
                    warn("被苹果挡了（Safari 这个会话），已停止刷新——再刷只会挡得更久。\n"
                         "  手机那条线不受影响，以手机为主继续刷。\n"
                         "  Mac 想再开一路：⌘⇧N 开无痕窗口、登录 Apple ID（要输密码），打开 %s 手动刷；"
                         "或等十几分钟自动解封。" % DEEP_URL, seconds=20)
                    time.sleep(21)
                    return
                if k in ("NOTFOUND", "MOVED") and target_match == DEEP_MATCH:
                    warn("深链接真的打不开了（%s），换去刷购买页：%s" % (why, SHOP_URL), seconds=8)
                    target_url, target_match = SHOP_URL, SHOP_MATCH
                    base_chars = None
                lw.set_tab_url(pos[0], pos[1], target_url)
                navigated = True
            elif target_match not in u:
                # 先分清：是深链接失效被苹果跳回购买页了，还是维护重定向之类
                if target_match == DEEP_MATCH and SHOP_MATCH in u:
                    k, why = clean_fetch(DEEP_URL)
                    if k == "MOVED":
                        warn("深链接失效了（%s），改刷购买页。" % why, seconds=8)
                        target_url, target_match = SHOP_URL, SHOP_MATCH
                        base_chars = None
                if target_match not in u:
                    # 拉回来（拉回本身就是一次加载，这轮不再额外刷新）
                    lw.set_tab_url(pos[0], pos[1], target_url)
                    navigated = True

            if not navigated:
                lw.reload_tab(*pos)
            n += 1
            state, r = lw.probe(*pos)

            if state == "HIT":
                hit(pos, "能买了——出现「加入购物袋」")
                break
            if state == "MAYBE":
                lw.reload_tab(*pos)
                st2, r2 = lw.probe(*pos)
                if st2 in ("HIT", "MAYBE"):
                    hit(pos, "能买了——待售提示没了（复核两次）")
                    break
                state = "复核没过"

            # —— 认不出的页面：宁可误报，也绝不在你可能正在下单的页面上继续刷 ——
            why_pause, is_queue = None, False
            last_sig[0] = None
            if page_has_any(pos, QUEUE_WORDS):
                is_queue = True
                why_pause = "这是排队页。千万别刷新、别关，等它自己放你进去。"
            elif r and not r["pending"] and r["chars"] >= lw.RENDER_FLOOR:
                time.sleep(1.5)                       # 先排除「还没渲染完」
                r3 = lw.read_tab(*pos)
                if r3 and r3["prod"] and r3["buy"]:
                    hit(pos, "能买了——出现「加入购物袋」")
                    break
                if r3 and not r3["pending"] and r3["chars"] >= lw.RENDER_FLOOR:
                    sig = (r3["prod"], round(r3["chars"] / 500.0))
                    if sig not in dismissed:
                        why_pause = "页面变样了（%d 字，待售提示没了），脚本认不出能不能买。" % r3["chars"]
                        last_sig[0] = sig
            if why_pause:
                paused.set()
                print("\n" + "!" * 64)
                print("‖ 已暂停刷新   [%s]" % two_clocks())
                print("‖ " + why_pause)
                print("‖ 能买 → 直接在 Safari 里买（不折抵 → AppleCare 第一个 → 加入购物袋）")
                if is_queue:
                    print("‖ 排队页不会自动刷。进去了直接买；要关闭 → 按 Return")
                else:
                    print("‖ 不能买 → 按 Control+C 立刻继续刷；你不碰它的话 %d 秒后自动接着刷" % AUTO_RESUME_SECONDS)
                    print("‖ 你动了鼠标/键盘、或页面有变化 → 一直等着，不会刷掉你选的   要关闭 → 按 Return")
                if FRONT:
                    lw.maximize_window(pos[0])
                    lw.bring_front(*pos)
                lw.notify("Duo 已暂停刷新", why_pause)
                lw.start_ring(SOUND_WARN, 120)
                # 基准要等页面自己稳住（连续两次一样）才定——刚停下时页面可能还在懒加载，
                # 那时的变化不是你点的（10/13 实测踩过：误判成「你在操作」，一直不自动刷）
                fp0, fp_prev, same = None, page_fingerprint(pos), 0
                t_pause = time.time()
                touched, how = False, "你按了 Control+C"
                while paused.is_set():
                    if any(h in tab_url(pos).lower() for h in HANDOVER_HINTS):
                        lw.stop_ring()
                        print("\n你已经点进购物袋/结账了，脚本撒手不管。")
                        return
                    left = AUTO_RESUME_SECONDS - (time.time() - t_pause)
                    if not is_queue and not touched:
                        # 暂停之后你动过鼠标/键盘 = 你在操作（哪怕页面卡着没变化），绝不自动刷
                        idle = hid_idle_seconds()
                        if idle is not None and idle + 0.5 < time.time() - t_pause:
                            touched = True
                        fp = page_fingerprint(pos)
                        if fp0 is None:
                            same = same + 1 if (fp and fp == fp_prev) else 0
                            if same >= 2:
                                fp0 = fp              # 连续 3 次一样 = 页面稳住了，这才是基准
                            fp_prev = fp
                        elif fp and fp != fp0:
                            touched = True            # 稳住之后又变了 = 你在操作页面，绝不自动刷
                        if not touched and left <= 0:
                            paused.clear()
                            how = "%d 秒没动静，自动" % AUTO_RESUME_SECONDS
                            break
                    if is_queue:
                        tip = "排队页 · 不自动刷 · Return 关闭"
                    elif touched:
                        tip = "你在操作 · 一直等你 · Control+C 继续 · Return 关闭"
                    else:
                        tip = "%d 秒后自动接着刷 · Control+C 立刻刷 · Return 关闭" % max(0, int(left + 0.99))
                    status("[%s] 暂停中 · %s" % (time.strftime("%H:%M:%S"), tip))
                    time.sleep(0.5)
                lw.stop_ring()
                if last_sig[0]:
                    dismissed.add(last_sig[0])        # 同样的页面不再为它停
                print("\n>>> %s继续刷。[%s]" % (how, two_clocks()))
                continue

            tag = {"PENDING": "待售", "OTHER": "非商品页(维护/转圈)"}.get(state, state)
            status("[%s] 第 %d 次 · %s · %s节奏" % (time.strftime("%H:%M:%S"), n, tag, phase))

            rest = gap - (time.time() - t0)
            if rest > 0:
                time.sleep(rest)

        # 刷到了：不再刷新，等你静音
        while lw._ring_until > time.time():
            time.sleep(0.5)
        print("\n铃停了。脚本结束，窗口留着。")
    except KeyboardInterrupt:
        raise


def hard_stop():
    """Return：任何阶段（倒计时、刷新中、响铃中）立刻全停，连铃声一起掐掉。"""
    lw.stop_ring()
    import subprocess
    subprocess.run(["pkill", "-x", "afplay"], capture_output=True)
    print("\n\n■ 已强制关闭。一次都不会再刷。Safari 窗口留着，你可以手动接着刷。")


if __name__ == "__main__":
    import signal
    # 启动早期（还没装上「Control+C=开刷」之前）按 Control+C 就照常退出
    signal.signal(signal.SIGINT, signal.default_int_handler)
    try:
        main()
    except KeyboardInterrupt:
        hard_stop()
    finally:
        restore_tty()
