def hid_idle_seconds():
    """距离你上次动鼠标/触控板/键盘过了几秒（macOS 自己记的，不需要任何权限）。读不到返回 None。"""
    import subprocess
    try:
        out = subprocess.run(["ioreg", "-c", "IOHIDSystem"], capture_output=True, text=True, timeout=3).stdout
        for line in out.splitlines():
            if "HIDIdleTime" in line:
                return int(line.split("=")[-1].strip()) / 1e9
    except Exception:
        pass
    return None


def page_fingerprint(pos):
    """整页文字的指纹。你在页面上点了选项，文字就会变——用来判断你是不是在操作。"""
    import hashlib
    t = lw.osa('tell application "Safari" to return (text of tab %d of window id %d) as string'
               % (pos[1], pos[0]))
    if not t:
        return None
    # 苹果页面会自己冒出又消失的读屏提示（10/13 实测：「图库已更新，」），不算你操作
    t = "\n".join(l for l in t.splitlines() if "已更新" not in l)
    return hashlib.md5(t.encode("utf-8")).hexdigest()


def page_has_any(pos, words):
