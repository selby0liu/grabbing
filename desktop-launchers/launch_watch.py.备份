def usable_frame():
    """真正能用的屏幕区域（避开菜单栏和程序坞）。

    Finder 报的是整块屏幕（含程序坞底下那块），照它摆窗口，
    底下那个会被程序坞压住点不到。办法是：故意把某个窗口设成远超屏幕的尺寸，
    Safari 会自己把它压回合法范围，读回来就是答案。
    实测这台机器：Finder 说 0,0,2560,1440，Safari 压回 y 30→1350（顶 30 底 90）。
    横向 Safari 不管，得自己按 Finder 的值夹住。
    """
    b = osa('tell application "Finder" to get bounds of window of desktop')
    try:
        fx0, fy0, fx1, fy1 = [int(v.strip()) for v in b.split(",")]
    except Exception:
        return None
    n = osa('tell application "Safari" to count of windows')
    try:
        if int(n or 0) < 1:
            return (fx0, fy0 + 25, fx1, fy1 - 100)   # 没窗口可试探，按经验留边
    except Exception:
        return (fx0, fy0 + 25, fx1, fy1 - 100)
    keep = osa('tell application "Safari" to get bounds of window 1')
    osa('tell application "Safari" to set bounds of window 1 to {%d, %d, %d, %d}'
        % (fx0 - 200, fy0 - 200, fx1 + 1000, fy1 + 1000))
    got = osa('tell application "Safari" to get bounds of window 1')
    if keep:
        osa('tell application "Safari" to set bounds of window 1 to {%s}' % keep)
    try:
        _, uy0, _, uy1 = [int(v.strip()) for v in got.split(",")]
        return (fx0, uy0, fx1, uy1)
    except Exception:
        return (fx0, fy0 + 25, fx1, fy1 - 100)


def maximize_window(wi):
    """把窗口撑到整个屏幕。有货的那一刻自动调用——
    你不用再手忙脚乱拖窗口，直接下单。"""
    f = usable_frame()
    if not f:
        return False
    osa('tell application "Safari" to set bounds of window %d to {%d, %d, %d, %d}'
        % (wi, f[0], f[1], f[2], f[3]))
    return True


def tile_windows(order):
    """把 order 里的窗口号从左到右并排摆满屏幕。"""
    b = osa('tell application "Finder" to get bounds of window of desktop')
    try:
        x0, y0, x1, y1 = [int(v.strip()) for v in b.split(",")]
    except Exception:
        return False
    top = y0 + 25                      # 让开菜单栏
    n = len(order)
    if n == 0:
        return False
    w = (x1 - x0) // n
    for i, wi in enumerate(order):
        left = x0 + i * w
        right = x1 if i == n - 1 else left + w
        osa('tell application "Safari" to set bounds of window %d to {%d, %d, %d, %d}'
            % (wi, left, top, right, y1))
    return True


# ---------- 响铃（后台线程，不挡主循环） ----------

_ring_until = 0.0
_ring_sound = SOUND_DIR % "Glass"
_ring_lock = threading.Lock()


def _ring_worker():
    while True:
        with _ring_lock:
            until, snd = _ring_until, _ring_sound
        if time.time() < until:
            subprocess.run(["afplay", snd], capture_output=True)
            time.sleep(0.2)
        else:
            time.sleep(0.3)


def start_ring(sound_name, seconds=RING_SECONDS):
    global _ring_until, _ring_sound
    with _ring_lock:
        _ring_sound = SOUND_DIR % sound_name
        _ring_until = max(_ring_until, time.time() + seconds)


def stop_ring():
    global _ring_until
    with _ring_lock:
        _ring_until = 0.0


def _stdin_worker():
    try:
        for _ in sys.stdin:
            stop_ring()
            print("\n已静音。脚本还在盯别的页面。")
    except Exception:
        pass


# ---------- 判断 ----------

def probe(wi, ti):
    """刷新之后立刻看，返回 (结论, 读数)。这是整个脚本的判断核心。

    关键在于分清两类信号：
      「存在」型 —— 页面没加载完只会少字，不会凭空多出字。所以看到就能立刻下结论，
                    一秒都不用等。「加入购物袋」和「暂无供应」都属于这类。
      「消失」型 —— 半成品页面会冒充「某句话没了」，所以必须等页面稳定下来才能算数。

    四种结论：
      HIT     商品页 + 出现「加入购物袋」 → 能买了，立刻信
      PENDING 「暂无供应」这类待售提示还在 → 肯定还没开卖，立刻返回去再刷（不等）
      MAYBE   还是商品页，但待售提示都没了 → 可能开卖了，交给上层再刷一次复核
      OTHER   压根不是商品页（维护页、加载失败等）→ 继续刷，绝不当成开卖
    """
    t0 = time.time()
    prev, same, last = None, 0, None
    while time.time() - t0 < SETTLE_TIMEOUT:
        r = read_tab(wi, ti)
        if r is None:
            time.sleep(POLL_STEP)
            continue
        last = r

        # ——「存在」型：立刻下结论，不等 ——
        if r["prod"] and r["buy"]:
            return "HIT", r
        if r["pending"]:
            return "PENDING", r      # 还是待售 → 马上回去再刷

        # —— 剩下的都含糊：维护页？没加载完？还是真开卖了？必须等稳定 ——
        if prev is not None and prev > 0:
            drift = abs(r["chars"] - prev) / float(prev)
            same = same + 1 if drift < SETTLE_TOLERANCE else 0
            # 加载途中字数只涨不跌，中途会短暂平一下（实测在 4575 字平过），
            # 所以长页面要连稳 2 次，短页面（维护页）要连稳 3 次。
            need = 2 if r["chars"] >= RENDER_FLOOR else 3
            if r["chars"] > 0 and same >= need:
                return ("MAYBE" if r["prod"] else "OTHER"), r
        prev = r["chars"]
        time.sleep(POLL_STEP)

    # 超时了什么都没确认。保守起见当成 OTHER，下一轮再看，绝不误报开卖。
    return "OTHER", last


def push_bark(title, body):
    try:
        cfg = json.load(open(MAC_CFG, encoding="utf-8"))
        b = cfg.get("notification", {}).get("bark", {})
        if not b.get("enabled") or not b.get("url"):
            return False
        url = b["url"].rstrip("/") + "/" + urllib.parse.quote(title) + \
            "/" + urllib.parse.quote(body) + "?level=critical&sound=alarm"
        urllib.request.urlopen(url, timeout=6).read()
        return True
    except Exception:
        return False


def notify(title, body):
    osa('display notification "%s" with title "%s"'
        % (body.replace('"', "'"), title.replace('"', "'")))


