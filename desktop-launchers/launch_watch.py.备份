LAYOUT_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "window_layout.json")

# 三个窗口在布局文件里的身份
LAYOUT_KEYS = [("home", "apple.com.cn", "shop"),
               ("white", "mk2p4ch", None),
               ("black", "mk2q4ch", None)]


def read_layout_now():
    """读当前三个窗口的位置和前后层次。"""
    out = []
    for key, match, ex in LAYOUT_KEYS:
        pos = find_tab(match, ex)
        if not pos:
            continue
        b = osa('tell application "Safari" to get bounds of window %d' % pos[0])
        try:
            v = [int(x.strip()) for x in b.split(",")]
        except Exception:
            continue
        out.append({"key": key, "bounds": v, "index": pos[0]})
    out.sort(key=lambda d: d["index"])      # index 小的在前面（更靠上层）
    return out


def save_layout():
    """把你现在手动摆好的样子存下来，以后 --setup 原样还原。"""
    lay = read_layout_now()
    if not lay:
        print("一个窗口都没找到，没得存。")
        return False
    json.dump(lay, open(LAYOUT_FILE, "w", encoding="utf-8"),
              ensure_ascii=False, indent=2)
    print("已记下你现在的摆法（%s）：" % LAYOUT_FILE)
    for i, d in enumerate(lay):
        b = d["bounds"]
        print("  第%d层(前→后)  %-6s  %d,%d → %d,%d   宽%d"
              % (i + 1, d["key"], b[0], b[1], b[2], b[3], b[2] - b[0]))
    print("\n以后点「1 · 摆好窗口」就还原成这个样子。")
    return True


def load_layout():
    try:
        return json.load(open(LAYOUT_FILE, encoding="utf-8"))
    except Exception:
        return None


def apply_layout(lay):
    """按存下来的位置和层次还原。"""
    m = {k: (mt, ex) for k, mt, ex in LAYOUT_KEYS}
    done = 0
    for d in lay:
        mt, ex = m.get(d["key"], (None, None))
        if not mt:
            continue
        pos = find_tab(mt, ex)
        if not pos:
            continue
        b = d["bounds"]
        osa('tell application "Safari" to set bounds of window %d to {%d, %d, %d, %d}'
            % (pos[0], b[0], b[1], b[2], b[3]))
        time.sleep(0.3)
        done += 1
    # 层次：倒着提，最后提的那个在最前
    for d in reversed(lay):
        mt, ex = m.get(d["key"], (None, None))
        if mt:
            raise_window(mt, ex)
    return done


def raise_window(match, exclude=None):
    """把某个窗口提到最前。序号会随着提升而变，所以每次都重新查。"""
    pos = find_tab(match, exclude)
    if pos:
        osa('tell application "Safari" to set index of window %d to 1' % pos[0])
        time.sleep(0.4)


def setup_windows(targets, win_width=CASCADE_WIDTH):
    """层叠布局（用户 2026-09-25 选定）：三个窗口从左到右依次错开，互相压住一部分。

        左  苹果官网首页   露出左边一条    ← 救急入口，脚本不刷新
        中  星光白 512GB   完整显示        ← 你真正要买的
        右  夜空色 512GB   露出右边一条

    每个窗口都 1120px 宽，远高于 852 的桌面版门槛，所以三个都是桌面版布局。
    露出来的那条恰好是页面左半边——「iPhone Duo」「机型将在获得批准后发售」
    「RMB 17,999」全在那儿，一眼能看到。被压住的是右边那栏（折抵换购、分期、
    以及开卖后的「加入购物袋」按钮），但有货时那个窗口会自动撑满全屏，不影响下单。
    """
    print("清掉旧的商品标签页（只关这几个网址，首页不动）……")
    close_target_tabs()

    f = usable_frame()
    if not f:
        print("读不到屏幕尺寸，窗口只开不摆，你自己拖。")
        f = None
    else:
        print("可用屏幕区域 %d×%d（已避开菜单栏和程序坞）" % (f[2] - f[0], f[3] - f[1]))

    # 从左到右的顺序：首页、星光白、夜空色（照你截图那个排法）
    home = find_tab("apple.com.cn", "shop")
    order = []
    if home:
        order.append(("苹果官网首页", "apple.com.cn", "shop", None))
    for tg in targets:
        print("拉起独立窗口：%s" % tg["label"])
        osa('tell application "Safari" to make new document with properties {URL:"%s"}' % tg["url"])
        time.sleep(2.5)
        if find_tab(tg["match"], tg["exclude"]):
            order.append((tg["label"], tg["match"], tg["exclude"], tg))
        else:
            print("  ! %s 没开起来" % tg["label"])

    lay = load_layout()
    if lay:
        n2 = apply_layout(lay)
        print("按你存好的摆法还原了 %d 个窗口。" % n2)
        print("")
        print("想改？自己把窗口拖成想要的样子，然后跑：")
        print("    python3 launch_watch.py --save-layout")
        print("")
        print("就算现在页面全显示「我们马上回来」也没关系——")
        print("脚本认的是地址栏里的网址，不是页面上写什么。")
        return True

    if f and order:
        x0, y0, x1, y1 = f
        n = len(order)
        w = min(win_width, x1 - x0)
        step = (x1 - x0 - w) // (n - 1) if n > 1 else 0
        print("每个窗口 %d px 宽，依次错开 %d px（露出来的那条就是页面左半边）。" % (w, step))
        for i2, (label, match, ex, _tg) in enumerate(order):
            pos = find_tab(match, ex)      # 新建窗口会让序号前移，必须重查
            if not pos:
                continue
            left = x0 + i2 * step
            osa('tell application "Safari" to set bounds of window %d to {%d, %d, %d, %d}'
                % (pos[0], left, y0, left + w, y1))
            time.sleep(0.3)

        # 层次：首页垫底，夜空色次之，星光白压在最上面完整显示。
        # 依次提升，最后提的那个在最前。
        for label, match, ex, tg in order:
            if tg is None or tg.get("key") != "white":
                raise_window(match, ex)
        raise_window("mk2p4ch")

    print("")
    for i2, (label, match, ex, tg) in enumerate(order):
        where = "完整显示" if (tg and tg.get("key") == "white") else "露出一条"
        who = "救急入口，脚本不刷新它" if tg is None else "归脚本，提示音 %s" % tg["sound"]
        print("  %-12s %-8s  ← %s" % (label, where, who))
    print("")
    print("就算现在页面全显示「我们马上回来」也没关系——")
    print("脚本认的是地址栏里的网址，不是页面上写什么。")
    return bool(order)


# ---------- 主流程 ----------

def ensure_tabs(targets, own_windows):
    def look(tg, tries=3):
        for i in range(tries):
            pos = find_tab(tg["match"], tg["exclude"])
            if pos:
                return pos
            if i + 1 < tries:
                time.sleep(0.8)
        return None

    ready = []
    for tg in targets:
        if look(tg) is None:                 # 连查三次都没有，才真的是没开
            print("  打开 %s ……" % tg["label"])
            open_tab(tg["url"], own_windows)
            time.sleep(3.0)
        if look(tg) is None:
            print("  ! %s 打不开，跳过" % tg["label"])
        else:
            ready.append(tg)
    return ready


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--interval", type=float, default=0.0,
                    help="每轮额外停几秒；默认 0（刷新+渲染本身就要 2-4 秒）")
    ap.add_argument("--start", default="",
                    help="HH:MM；在这之前每分钟刷一次待命，到点自动转全速")
    ap.add_argument("--windows", action="store_true",
                    help="每个页面单独一个窗口，并排摆满屏幕")
    ap.add_argument("--no-front", action="store_true",
                    help="有货也不抢焦点，只出声（窗口已经并排摆好时可以用）")
    ap.add_argument("--with-shop", action="store_true",
                    help="多开一个配置页窗口当退路（深链接万一打不开时用）")
    ap.add_argument("--max-minutes", type=float, default=180.0,
                    help="全速开始后最多跑多少分钟就自动停，默认 180；填 0 表示不限")
    ap.add_argument("--win-width", type=int, default=CASCADE_WIDTH,
                    help="层叠布局里每个窗口多宽，默认 %d；低于 880 页面会缩成手机版" % CASCADE_WIDTH)
    ap.add_argument("--save-layout", action="store_true",
                    help="把你现在手动摆好的窗口位置记下来，以后 --setup 原样还原")
    ap.add_argument("--setup", action="store_true",
                    help="开售前摆好窗口：左首页（归你）／右两个商品标签（归脚本），然后退出")
    ap.add_argument("--test", action="store_true", help="自检后退出")
    args = ap.parse_args()

    targets = [t for t in TARGETS if args.with_shop or not t.get("optional")]

    if args.save_layout:
        save_layout()
        return

    if args.setup:
        setup_windows(targets, args.win_width)
        return

    print("准备页面……")
    targets = ensure_tabs(targets, args.windows)
    if not targets:
        print("一个页面都没开起来，退出。")
        return

    if args.windows:
        order, seen = [], set()
        for tg in targets:
            pos = find_tab(tg["match"], tg["exclude"])
            if pos and pos[0] not in seen:
                seen.add(pos[0])
                order.append(pos[0])
        print("并排摆窗口：" + ("成功" if tile_windows(order) else "读不到屏幕尺寸，跳过"))

    print("\n基准：")
    base = {}
    for tg in targets:
        try:
            pos = find_tab(tg["match"], tg["exclude"])
            r, st = None, "OTHER"
            if pos:
                # 读两遍取字数大的那次。半成品只会偏小，取大的就不会拿半成品当基准。
                for _ in range(2):
                    st2, r2 = probe(*pos)
                    if r2 and (r is None or r2["chars"] > r["chars"]):
                        r, st = r2, st2
            said = False
        except Exception as e:
            r, st, said = None, "OTHER", True
            print("  %-12s 建立基准时出错（%s），跳过，不影响其它页面"
                  % (tg["label"], type(e).__name__))
        if r:
            base[tg["key"]] = {"chars": r["chars"], "had_pending": r["pending"]}
            print("  %-12s 字数 %6d  商品页=%-5s  待售提示=%-5s  可下单=%-5s  提示音=%s"
                  % (tg["label"], r["chars"], r["prod"], r["pending"],
                     r["buy"], tg["sound"]))
        elif not said:
            print("  %-12s 读不到（还是会盯着，只是没有基准）" % tg["label"])

    threading.Thread(target=_ring_worker, daemon=True).start()
    threading.Thread(target=_stdin_worker, daemon=True).start()

    if args.test:
        print("\n自检：三个提示音依次响一遍，然后置顶 + 通知 + Bark……")
        for tg in targets:
            print("  %s → %s" % (tg["label"], tg["sound"]))
            subprocess.run(["afplay", SOUND_DIR % tg["sound"]], capture_output=True)
        pos = find_tab(targets[0]["match"], targets[0]["exclude"])
        if pos:
            bring_front(*pos)
        notify("Duo 守夜自检", "这是自检，不是真的开卖")
        print("Bark：" + ("已发" if push_bark("Duo 守夜自检", "这是自检，不是真的开卖") else "没发出去"))
        print("三声音色不同、Safari 跳到前面、手机收到推送，就说明没问题。")
        return

    slow_until = None
    if args.start:
        try:
            hh, mm = [int(x) for x in args.start.split(":")]
            now = dt.datetime.now()
            slow_until = now.replace(hour=hh, minute=mm, second=0, microsecond=0)
            if slow_until < now:
                slow_until += dt.timedelta(days=1)
            print("\n待命模式：%s 之前每分钟刷一次，到点自动转全速。"
                  % slow_until.strftime("%m-%d %H:%M"))
        except Exception:
            print("--start 格式应该是 19:58，忽略。")
            slow_until = None

    print("\n开始。判定「能买了」有两条路：出现「加入购物袋」，或者"
          "「暂无供应」「机型将在获得批准后发售」全消失（会再刷一次复核）。")
    print("维护页不算，会一直刷下去。")
    print("全程只抢一次焦点，之后绝不打断你下单。Ctrl+C 退出。\n")

    hot, noticed = set(), {t["key"]: set() for t in targets}
    last_pos = {}          # 记住每个目标上次在哪，网址漂走时好把它拉回来
    deadline = None
    n = 0
    try:
        while True:
          try:
            slow = slow_until is not None and dt.datetime.now() < slow_until
            if slow_until is not None and not slow:
                print("\n\n>>> 到点了，转全速。\n")
                slow_until = None
            n += 1
            marks = []
            checked = 0
            for tg in targets:
              try:
                k = tg["key"]
                if k in hot:
                    marks.append("%s:已有货(冻结)" % tg["label"])
                    continue
                if not slow and n % tg.get("every", 1) != 0:
                    continue          # 这轮轮不到它
                checked += 1
                pos = find_tab(tg["match"], tg["exclude"])
                if pos:
                    last_pos[k] = pos
                else:
                    # 按网址找不着了。可能是苹果维护时重定向走了，也可能是你自己点进去了。
                    old_pos = last_pos.get(k)
                    if not old_pos:
                        marks.append("%s:窗口没了" % tg["label"])
                        continue
                    stray = read_tab(*old_pos)
                    su = (stray or {}).get("url", "").lower()
                    if not stray:
                        marks.append("%s:窗口没了" % tg["label"])
                        continue
                    # 别把别的目标的标签页抢过来
                    if any(t["match"].lower() in su for t in targets if t["key"] != k):
                        marks.append("%s:窗口没了" % tg["label"])
                        continue
                    if any(h in su for h in HANDOVER_HINTS):
                        marks.append("%s:你已接管,不碰" % tg["label"])
                        continue
                    # 网址漂了（维护重定向/报错页），拉回去
                    osa('tell application "Safari" to set URL of tab %d of window %d to "%s"'
                        % (old_pos[1], old_pos[0], tg["url"]))
                    time.sleep(1.0)
                    pos = find_tab(tg["match"], tg["exclude"]) or old_pos
                    last_pos[k] = pos
                    marks.append("%s:网址漂了,已拉回" % tg["label"])
                reload_tab(*pos)
                pos = find_tab(tg["match"], tg["exclude"]) or pos
                state, r = probe(*pos)
                if r is None:
                    marks.append("%s:读不到" % tg["label"])
                    continue

                # 能买了，第一种：商品页上直接出现「加入购物袋」。立刻信。
                if state == "HIT" and tg["buyable"]:
                    hot.add(k)          # 冻结，再也不刷它
                    announce(tg, pos, "能买了——出现「加入购物袋」", True, not args.no_front)
                    marks.append("%s:已有货(冻结)" % tg["label"])
                    continue

                # 能买了，第二种：还是商品页，但待售提示全没了。
                # 这是「消失」型，半成品会冒充，所以再刷一次复核才算数。
                if (state == "MAYBE" and tg["buyable"]
                        and base.get(k, {}).get("had_pending")):
                    reload_tab(*pos)
                    st2, r2 = probe(*pos)
                    if st2 in ("HIT", "MAYBE"):
                        hot.add(k)
                        announce(tg, pos, "能买了——待售提示全没了（已复核两次）",
                                 True, not args.no_front)
                        marks.append("%s:已有货(冻结)" % tg["label"])
                        continue
                    marks.append("%s:疑似变化,复核没过" % tg["label"])
                    continue

                # 到这里就是「还没开卖」：PENDING（待售提示还在）或 OTHER（维护页等）。
                # 什么都不用等，直接进下一轮马上再刷——这正是你要的「不用等，立刻继续刷」。
                # 字数比较只在「等到页面稳定」的情况下才有意义。
                # PENDING 是一看到待售提示就立刻返回的，页面根本没渲染完，
                # 字数是个半截数（实测在 8316~10813 之间乱跳），拿它比大小必然误判。
                # 何况对商品页来说，「待售提示还在不在」本来就比字数准得多。
                b = base.get(k)
                if state != "PENDING" and b and b["chars"] > 0:
                    d = abs(r["chars"] - b["chars"]) / float(b["chars"])
                    if d > 0.15 and "size" not in noticed[k]:
                        noticed[k].add("size")
                        announce(tg, pos, "页面变了 %d→%d 字（还不能买，继续刷）"
                                 % (b["chars"], r["chars"]), False, False)
                    base[k] = {"chars": r["chars"],
                               "had_pending": b.get("had_pending", False)}

                if state == "PENDING":
                    marks.append("%s:待售" % tg["label"])      # 字数是半截的，不显示免得误导
                else:
                    tag = {"OTHER": "非商品页", "MAYBE": "疑似"}.get(state, state)
                    marks.append("%s:%d字/%s" % (tg["label"], r["chars"], tag))
              except Exception as e:
                # 一个页面出岔子不能拖垮整晚，记一笔继续跑
                marks.append("%s:出错(%s)" % (tg["label"], type(e).__name__))
              if slow:
                  break
            sys.stdout.write("\r[%s] 第 %d 轮  %s        "
                             % (time.strftime("%H:%M:%S"), n, "  ".join(marks)))
            sys.stdout.flush()
            if deadline is None and not slow and args.max_minutes > 0:
                deadline = time.time() + args.max_minutes * 60
                print("\n（安全闸：%.0f 分钟后自动停，也就是 %s）\n"
                      % (args.max_minutes,
                         (dt.datetime.now() + dt.timedelta(minutes=args.max_minutes)).strftime("%H:%M")))
            if deadline and not slow and time.time() > deadline:
                stop_ring()
                print("\n\n到了 --max-minutes 上限，自动停。窗口都留着，你可以手动刷。")
                return
            if len(hot) == len([t for t in targets if t["buyable"]]):
                time.sleep(2.0)     # 该盯的都有货了，别再空转
            elif checked == 0:
                time.sleep(0.5)     # 这轮谁都没轮到，别空转烧 CPU
            else:
                time.sleep(60.0 if slow else args.interval)
          except KeyboardInterrupt:
            raise
          except Exception as e:
            print("\n主循环出错（%s: %s），3 秒后继续，不中断。" % (type(e).__name__, e))
            time.sleep(3.0)
    except KeyboardInterrupt:
        stop_ring()
        print("\n已退出。窗口都留着，你可以手动接着刷。")


if __name__ == "__main__":
    main()
